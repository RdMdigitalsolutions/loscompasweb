---
import SectionTitle from './SectionTitle.astro';
const combos = [
  { mood: 'Vienes con hambre', name: 'Menú Compas', price: '17,50 €', body: '4 tacos — tinga, cochinita, carnitas y birria — más totopos con guacamole.' },
  { mood: 'Vienes con tu compa', name: 'Menú para 2', price: '39,50 €', body: 'Nachos light, 6 tacos (2 tinga, 2 cochinita y 2 carnitas) y quesabirriosas.' },
  { mood: 'Viene toda la banda', name: 'Plato de tacos para compartir', price: '52,50 €', body: '16 tacos: 4 tinga, 4 cochinita, 4 carnitas y 4 birria.' },
];
---
<section class="section combos-section">
  <div class="shell">
    <SectionTitle eyebrow="Haz equipo" title="Combos y menús\npa' salir contento" accent="yellow" />
    <div class="combo-grid">
      {combos.map((combo, i) => <article class={`combo combo-${i + 1} reveal`}><p>{combo.mood}</p><h3>{combo.name}</h3><strong>{combo.price}</strong><div class="zigzag"></div><p>{combo.body}</p></article>)}
    </div>
  </div>
</section>
