---
import { desserts } from '../data/menu';
---
<section class="section desserts-section">
  <div class="shell dessert-paper reveal">
    <div class="skulls" aria-hidden="true">✦ ◈ ✦</div>
    <h2>Pa' el huequito<br />que queda</h2>
    <div class="dessert-list">{desserts.map(item => <article><div><h3>{item.name}</h3><p>{item.description}</p></div><strong>{item.price}</strong></article>)}</div>
  </div>
</section>
