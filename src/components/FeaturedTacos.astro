---
import SectionTitle from './SectionTitle.astro';
import { tacos } from '../data/menu';
const featured = tacos.filter((item) => item.featured);
---
<section id="favoritos" class="section cream-section">
  <div class="shell">
    <SectionTitle eyebrow="Aquí no falla nadie" title="Los favoritos\nde la banda" accent="pink" />
    <p class="section-intro">Los que vuelan más rápido que los totopos calientes.</p>
    <div class="featured-grid">
      {featured.map((item, index) => (
        <article class={`food-card card-${index + 1} reveal`}>
          <div class="card-top"><span class="card-number">0{index + 1}</span>{[0, 2].includes(index) && <span class="badge">🔥 Más pedido</span>}</div>
          <h3>{item.name}</h3>
          <p>{item.description}</p>
          <strong>{item.price}</strong>
        </article>
      ))}
    </div>
  </div>
</section>
