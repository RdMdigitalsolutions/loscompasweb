---
import { restaurant } from '../data/restaurant';
---
<section id="inicio" class="hero dark-texture">
  <div class="papel-picado" aria-hidden="true">
    <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
  </div>
  <div class="shell hero-inner">
    <div class="hero-copy reveal">
      <p class="eyebrow">Taquería · Almuñécar</p>
      <h1><span>Tacos</span><br />con todo<br /><em>menos miedo</em></h1>
      <p class="hero-lead">{restaurant.description}</p>
      <div class="hero-actions">
        <a class="button button-yellow" href="#carta"><span aria-hidden="true">🌮</span> Ver la carta</a>
        <a class="button button-outline" href={restaurant.mapsUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">📍</span> Cómo llegar</a>
      </div>
    </div>
    <div class="hero-mark reveal" aria-hidden="true">
      <div class="sunburst"></div>
      <img src="/images/logo-los-compas.png" width="440" height="440" alt="" />
      <span class="sticker sticker-taco">TACO<br />POWER</span>
      <span class="sticker sticker-chile">¡AJÚA!</span>
    </div>
  </div>
  <div class="scallop" aria-hidden="true"></div>
</section>
