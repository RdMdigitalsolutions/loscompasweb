---
import SectionTitle from './SectionTitle.astro';
import { allMenuItems } from '../data/menu';
---
<section id="carta" class="section menu-section dark-texture">
  <div class="shell">
    <SectionTitle eyebrow="La carta" title="¿Qué se te\nantoja hoy?" accent="turquoise" />
    <div class="menu-filters" role="toolbar" aria-label="Filtrar la carta">
      <button class="filter active" data-filter="all" aria-pressed="true">Todo</button>
      <button class="filter" data-filter="tacos" aria-pressed="false">🌮 Tacos</button>
      <button class="filter" data-filter="featured" aria-pressed="false">🔥 Más pedidos</button>
      <button class="filter" data-filter="spicy" aria-pressed="false">🌶️ Picante</button>
      <button class="filter" data-filter="vegetarian" aria-pressed="false">🌱 Vegetariano</button>
      <button class="filter" data-filter="drinks" aria-pressed="false">🍺 Bebidas</button>
      <button class="filter" data-filter="desserts" aria-pressed="false">🍰 Postres</button>
    </div>
    <p class="sr-only" aria-live="polite" data-filter-status></p>
    <div class="menu-list" data-menu-list>
      {allMenuItems.map((item) => (
        <article class="menu-item" data-category={item.category} data-featured={String(!!item.featured)} data-spicy={String(!!item.spicyLevel)} data-vegetarian={String(!!item.vegetarian)}>
          <div class="menu-item-main"><h3>{item.name}</h3><span class="dots" aria-hidden="true"></span><strong>{item.price}</strong></div>
          <p>{item.description}</p>
          <div class="item-labels">
            {item.featured && <span>🔥 Más pedido</span>}{!!item.spicyLevel && <span>{'🌶️'.repeat(item.spicyLevel)} Picante</span>}{item.vegetarian && <span>🌱 Vegetariano</span>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<script>
  const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
  const items = [...document.querySelectorAll<HTMLElement>('.menu-item')];
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  filters.forEach((button) => button.addEventListener('click', () => {
    const value = button.dataset.filter ?? 'all';
    filters.forEach((filter) => { filter.classList.toggle('active', filter === button); filter.setAttribute('aria-pressed', String(filter === button)); });
    let count = 0;
    items.forEach((item) => {
      const show = value === 'all' || item.dataset.category === value || item.dataset[value] === 'true';
      item.hidden = !show;
      if (show) count += 1;
    });
    if (status) status.textContent = `${count} productos mostrados`;
  }));
</script>
