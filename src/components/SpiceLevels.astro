---
import SectionTitle from './SectionTitle.astro';
const levels = [
  ['🌶️', 'Poquito pique', 'Un mexicano ni se entera... tú igual sacas el pañuelo.', 34],
  ['🌶️🌶️', 'Pica rico', 'Ya se siente. Nada grave, pero vas a respetar.', 67],
  ['🌶️🌶️🌶️', 'Pica sabroso', 'Aquí ya sudas tantito. Recomendable no hacerte el valiente.', 100],
];
---
<section class="section spice-section dark-texture">
  <div class="shell spice-layout">
    <div><SectionTitle eyebrow="La leyenda" title="¿Cuánto miedo\ntienes?" accent="coral" /><p class="section-intro">Tú eliges hasta dónde llega la valentía.</p></div>
    <div class="spice-meter">
      {levels.map(([icon, name, text, width]) => <article class="spice-row reveal"><span class="pepper">{icon}</span><div><h3>{name}</h3><p>{text}</p><div class="heat-track"><i style={`width:${width}%`}></i></div></div></article>)}
      <div class="legend-notes"><p><b>🔥 Los más pedidos</b><br />Los favoritos de la banda.</p><p><b>🌱 Vegetariano</b><br />Sin carne y con mucho sabor.</p></div>
    </div>
  </div>
</section>
