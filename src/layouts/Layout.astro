---
import '../styles/global.css';
import { restaurant } from '../data/restaurant';

const title = 'Taquería Los Compas | Tacos mexicanos en Almuñécar';
const description = 'Taquería Los Compas: tacos, birria, margaritas y auténtico sabor de México en Almuñécar. Consulta nuestra carta y ven a conocernos.';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: restaurant.name,
  telephone: '+34 604 455 286',
  address: {
    '@type': 'PostalAddress',
    streetAddress: restaurant.addressLine,
    addressLocality: restaurant.city,
    addressCountry: 'ES',
  },
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#24140f" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/images/logo-los-compas.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/logo-los-compas.png', canonical)} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
