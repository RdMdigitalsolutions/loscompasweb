---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeaturedTacos from '../components/FeaturedTacos.astro';
import Menu from '../components/Menu.astro';
import Combos from '../components/Combos.astro';
import SpiceLevels from '../components/SpiceLevels.astro';
import Sauces from '../components/Sauces.astro';
import Drinks from '../components/Drinks.astro';
import Desserts from '../components/Desserts.astro';
import RestaurantGallery from '../components/RestaurantGallery.astro';
import Instagram from '../components/Instagram.astro';
import Location from '../components/Location.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Header />
  <main id="contenido">
    <Hero /><FeaturedTacos /><Menu /><Combos /><SpiceLevels /><Sauces /><Drinks /><Desserts /><RestaurantGallery /><Instagram /><Location />
  </main>
  <Footer /><MobileActionBar />
</Layout>
<script>
  const observer = new IntersectionObserver((entries) => entries.forEach(entry => {
    if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
  }), { threshold: 0.12 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>
